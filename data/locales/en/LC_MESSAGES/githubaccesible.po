msgstr "Code"

#: app/services/busqueda.py:53 app/services/busqueda.py:290 app/services/github/api_extra.py:553
msgid "Issues y pull requests"
msgstr "Issues and pull requests"

#: app/services/busqueda.py:54 app/services/github/api_extra.py:554
msgid "Usuarios y organizaciones"
msgstr "Users and organizations"

#: app/services/busqueda.py:55 app/services/github/api_extra.py:555 app/ui/detalle/pull_request.py:279 app/ui/repositorio/ventana.py:62 app/ui/repositorio/vistas.py:1432
msgid "Commits"
msgstr "Commits"

#: app/services/busqueda.py:56 app/services/busqueda.py:240 app/services/github/api_extra.py:556
msgid "Temas"
msgstr "Topics"

#: app/services/busqueda.py:57 app/services/busqueda.py:345 app/services/github/api_extra.py:557 app/ui/git/ventana_git.py:1257 app/ui/repositorio/vistas.py:581 app/ui/repositorio/vistas.py:810 app/ui/vistas/principales.py:95 app/ui/vistas/principales.py:847
