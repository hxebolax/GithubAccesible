msgstr "Labels"

#: app/services/busqueda.py:58 app/ui/repositorio/ventana.py:57 app/ui/repositorio/vistas.py:897
msgid "Discusiones"
msgstr "Discussions"

#: app/services/busqueda.py:59
msgid "Tendencias"
msgstr "Trending"

#: app/services/busqueda.py:66 app/services/busqueda.py:68 app/services/busqueda.py:69 app/services/busqueda.py:74 app/services/busqueda.py:75 app/services/busqueda.py:76 app/services/busqueda.py:77 app/services/busqueda.py:78
msgid "Mejor coincidencia"
msgstr "Best match"

#: app/services/busqueda.py:66 app/services/busqueda.py:249 app/ui/busqueda.py:521 app/ui/detalle/usuario.py:243 app/ui/vistas/principales.py:50 app/ui/vistas/principales.py:852
msgid "Estrellas"
msgstr "Stars"

#: app/services/busqueda.py:66 app/services/busqueda.py:250 app/services/busqueda.py:286 app/ui/repositorio/ventana.py:68 app/ui/vistas/principales.py:51 app/ui/vistas/principales.py:854
msgid "Bifurcaciones"
msgstr "Forks"

#: app/services/busqueda.py:67
msgid "Issues que piden ayuda"
msgstr "Help wanted issues"

#: app/services/busqueda.py:67
msgid "Actualizados recientemente"
msgstr "Recently updated"

#: app/services/busqueda.py:69 app/services/busqueda.py:77 app/services/busqueda.py:253 app/services/busqueda.py:331 app/services/busqueda.py:394 app/services/busqueda.py:416
