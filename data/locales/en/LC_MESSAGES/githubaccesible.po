#: app/core/base_datos.py:213
#, python-brace-format
msgid "La base de datos estaba dañada y se ha restaurado la copia de seguridad «{copia}». Pueden faltar los cambios posteriores a esa copia."
msgstr "The database was damaged and the backup “{copia}” has been restored. Changes made after that backup may be missing."

#: app/core/base_datos.py:215
msgid "La base de datos estaba dañada y no había copias de seguridad sanas: se ha creado una nueva vacía. El archivo dañado se conserva en la carpeta de la base de datos."
msgstr "The database was damaged and there were no healthy backups, so a new empty one has been created. The damaged file has been kept in the database folder."

#: app/core/base_datos.py:357
msgid "La base de datos está bloqueada por otro programa (antivirus, copia de seguridad u otra instancia). No se ha tocado ningún dato."
msgstr "The database is locked by another program (antivirus, backup or another instance). No data has been changed."

#: app/core/base_datos.py:462
#, python-brace-format
msgid "La base de datos es de la versión {actual} y esta aplicación solo conoce hasta la {total}. Se creó con una versión más nueva de la aplicación; actualízala para abrirla."
msgstr "The database is version {actual} and this application only supports up to version {total}. It was created with a newer version of the application; update the application to open it."

#: app/core/configuracion.py:395
#, python-brace-format
msgid "«{clave}» espera {esperado} y recibió {recibido}."
msgstr "“{clave}” expects {esperado} but received {recibido}."

#: app/core/configuracion.py:402
#, python-brace-format
msgid "«{clave}» solo admite: {opciones}."
msgstr "“{clave}” only accepts: {opciones}."

#: app/core/configuracion.py:406
#, python-brace-format
msgid "«{clave}» debe ser como mínimo {minimo}."
msgstr "“{clave}” must be at least {minimo}."

#: app/core/configuracion.py:408
#, python-brace-format
msgid "«{clave}» debe ser como máximo {maximo}."
msgstr "“{clave}” must be at most {maximo}."

#: app/core/configuracion.py:410
#, python-brace-format
msgid "«{clave}» admite como máximo {n} caracteres."
msgstr "“{clave}” accepts at most {n} characters."

#: app/core/configuracion.py:547
msgid "La configuración estaba dañada y se ha recuperado la copia anterior."
msgstr "The settings were damaged and the previous copy has been restored."

#: app/core/configuracion.py:551
msgid "La configuración estaba dañada y se han restablecido los valores de fábrica."
msgstr "The settings were damaged and the defaults have been restored."

#: app/core/configuracion.py:557
msgid "No se pudo leer la configuración; se usan valores de fábrica sin guardar."
msgstr "Could not read the settings; using defaults, which will not be saved."

#: app/core/configuracion.py:810
#, python-brace-format
msgid "No se pudo guardar la configuración: {error}"
msgstr "Could not save the settings: {error}"

#: app/core/descargas.py:72 app/services/github/cliente.py:729
msgid "Descarga cancelada."
msgstr "Download canceled."

#: app/core/descargas.py:166
msgid "No se ha encontrado un nombre libre para el archivo."
msgstr "Could not find an available name for the file."

#: app/core/descargas.py:309
msgid "El servidor ha redirigido la descarga a una conexión no cifrada; se ha detenido por seguridad."
msgstr "The server redirected the download to an unencrypted connection; it has been stopped for security."

#: app/core/descargas.py:331
#, python-brace-format
msgid "El archivo es demasiado grande ({megas:.0f} MB)."
msgstr "The file is too large ({megas:.0f} MB)."

#: app/core/descargas.py:350
msgid "El servidor no permite descargar este archivo."
msgstr "The server does not allow this file to be downloaded."

#: app/core/descargas.py:354
msgid "La descarga se ha cortado antes de terminar. Vuelve a intentarlo para continuar donde se quedó."
msgstr "The download was interrupted before it finished. Try again to resume where it left off."

#: app/core/descargas.py:361
msgid "El archivo descargado está dañado (su suma de comprobación no coincide) y se ha descartado. Vuelve a intentarlo."
msgstr "The downloaded file is damaged (its checksum does not match) and has been discarded. Try again."

#: app/core/descargas.py:440
msgid "El archivo es más grande de lo permitido."
msgstr "The file is larger than allowed."

#: app/core/red.py:175
#, python-brace-format
msgid "El servidor ha pedido que esperemos unos {minutos} minutos antes de volver a intentarlo."
msgstr "The server has asked us to wait about {minutos} minutes before trying again."

#: app/core/red.py:440
msgid "El servidor no ha entendido la petición (error 400)."
msgstr "The server did not understand the request (error 400)."

#: app/core/red.py:441
msgid "Hace falta iniciar sesión o la sesión ha caducado (error 401)."
msgstr "You need to sign in, or your session has expired (error 401)."

#: app/core/red.py:442
msgid "El servidor ha denegado el acceso (error 403)."
msgstr "The server denied access (error 403)."

#: app/core/red.py:443
msgid "No se ha encontrado lo que se buscaba en el servidor (error 404)."
msgstr "What was requested could not be found on the server (error 404)."

#: app/core/red.py:444
msgid "El servidor tardó demasiado en recibir la petición (error 408)."
msgstr "The server took too long to receive the request (error 408)."

#: app/core/red.py:445
msgid "El recurso ya no existe en el servidor (error 410)."
msgstr "The resource no longer exists on the server (error 410)."

#: app/core/red.py:446
msgid "El envío es demasiado grande para el servidor (error 413)."
msgstr "The upload is too large for the server (error 413)."

#: app/core/red.py:447
msgid "El servidor no admite continuar desde ese punto (error 416)."
msgstr "The server does not support resuming from that point (error 416)."

#: app/core/red.py:448
msgid "El servidor está recibiendo demasiadas peticiones; se volverá a intentar más tarde (error 429)."
msgstr "The server is receiving too many requests; the request will be retried later (error 429)."

#: app/core/red.py:449
msgid "El servidor ha tenido un error interno (error 500)."
msgstr "The server had an internal error (error 500)."

#: app/core/red.py:450
msgid "El servidor no está disponible en este momento (error 502)."
msgstr "The server is not available right now (error 502)."

#: app/core/red.py:451
msgid "El servidor está saturado o en mantenimiento (error 503)."
msgstr "The server is overloaded or under maintenance (error 503)."

#: app/core/red.py:452
msgid "El servidor tardó demasiado en responder (error 504)."
msgstr "The server took too long to respond (error 504)."

#: app/core/red.py:462
#, python-brace-format
msgid "El servidor ha rechazado la petición (error {codigo})."
msgstr "The server rejected the request (error {codigo})."

#: app/core/red.py:464
#, python-brace-format
msgid "El servidor ha fallado (error {codigo})."
msgstr "The server failed (error {codigo})."

#: app/core/red.py:466
#, python-brace-format
msgid "Respuesta inesperada del servidor (código {codigo})."
msgstr "Unexpected response from the server (code {codigo})."

#: app/core/red.py:504
msgid "Error desconocido."
msgstr "Unknown error."

#: app/core/red.py:523 app/services/git_local.py:276 app/ui/git/clonar.py:227 app/ui/git/ventana_git.py:581
msgid "Operación cancelada."
msgstr "Operation canceled."

#: app/core/red.py:529
msgid "No se ha podido comprobar la identidad del servidor (certificado no válido). Por seguridad no se ha conectado. Revisa la fecha y la hora del equipo o avisa al administrador del servidor."
msgstr "Could not verify the server's identity (invalid certificate). For security, no connection was made. Check your computer's date and time, or contact the server administrator."

#: app/core/red.py:533
msgid "No se ha podido conectar a través del proxy. Revisa la configuración del proxy en las preferencias."
msgstr "Could not connect through the proxy. Check the proxy settings in Preferences."

#: app/core/red.py:536
msgid "El servidor no ha respondido a tiempo al conectar. Comprueba la conexión e inténtalo de nuevo."
msgstr "The server did not respond in time while connecting. Check your connection and try again."

#: app/core/red.py:538
msgid "El servidor ha dejado de responder. Inténtalo de nuevo dentro de un momento."
msgstr "The server stopped responding. Try again in a moment."

#: app/core/red.py:540
msgid "El servidor redirige una y otra vez sin llegar a ningún sitio."
msgstr "The server keeps redirecting without getting anywhere."

#: app/core/red.py:543
msgid "La dirección no es válida."
msgstr "The address is not valid."

#: app/core/red.py:549
msgid "No se ha encontrado el servidor. Comprueba la dirección y que haya conexión a Internet."
msgstr "The server could not be found. Check the address and make sure you are connected to the Internet."

#: app/core/red.py:553
msgid "La conexión se ha cortado mientras se recibían los datos. Inténtalo de nuevo."
msgstr "The connection was lost while receiving data. Try again."

#: app/core/red.py:556
msgid "No se ha podido conectar con el servidor. Comprueba la conexión a Internet e inténtalo de nuevo."
msgstr "Could not connect to the server. Check your Internet connection and try again."

#: app/core/red.py:559
msgid "No hay permiso para escribir en la carpeta de destino, o el archivo está abierto en otro programa."
msgstr "You do not have permission to write to the destination folder, or the file is open in another program."

#: app/core/red.py:561
msgid "No queda espacio libre en el disco."
msgstr "There is no free space left on the disk."

#: app/core/red.py:563
msgid "Ha fallado la comunicación con el servidor."
msgstr "Communication with the server failed."

#: app/core/red.py:564
msgid "Se ha producido un error inesperado."
msgstr "An unexpected error occurred."

#: app/core/secretos.py:125
#, python-brace-format
msgid "DPAPI falló (código {codigo}): {mensaje}"
msgstr "DPAPI failed (code {codigo}): {mensaje}"

#: app/core/secretos.py:279
msgid "No se pudo apartar el archivo de secretos ilegible."
msgstr "Could not move the unreadable secrets file aside."

#: app/core/secretos.py:309
#, python-brace-format
msgid "No se pudieron guardar los secretos: {error}"
msgstr "Could not save the secrets: {error}"

#: app/core/tareas.py:222
msgid "Cancelado por el usuario"
msgstr "Canceled by the user"

#: app/core/tareas.py:726
msgid "Esa operación ya está en curso."
msgstr "That operation is already in progress."

#: app/core/tareas.py:794
msgid "La aplicación se está cerrando"
msgstr "The application is closing"

#: app/core/tareas.py:880 app/services/formato.py:191
msgid "Cancelada"
msgstr "Canceled"

#: app/core/tareas.py:984
#, python-brace-format
msgid "La operación «{nombre}» superó el tiempo máximo de {segundos:g} s."
msgstr "The operation “{nombre}” exceeded the maximum time of {segundos:g} s."

#: app/core/tareas.py:988 app/services/formato.py:194
msgid "Tiempo agotado"
msgstr "Timed out"

#: app/services/actualizador.py:299
#, python-brace-format
msgid "Versión {version}"
msgstr "Version {version}"

#: app/services/actualizador.py:385
#, python-brace-format
msgid "Versión no válida: {texto!r}"
msgstr "Invalid version: {texto!r}"

#: app/services/actualizador.py:440
msgid "La aplicación no tiene configurada ninguna clave de verificación; por seguridad no se aceptan actualizaciones."
msgstr "The application has no verification key configured; for security, updates are not accepted."

#: app/services/actualizador.py:446
msgid "La información de la versión nueva no está firmada; no se instalará."
msgstr "The information for the new version is not signed; it will not be installed."

#: app/services/actualizador.py:450
msgid "La firma de la versión nueva está dañada; no se instalará."
msgstr "The signature of the new version is damaged; it will not be installed."

#: app/services/actualizador.py:457
msgid "Falta el componente que verifica las firmas; no se puede actualizar de forma segura."
msgstr "The component that verifies signatures is missing; the application cannot be updated safely."

#: app/services/actualizador.py:473
msgid "La firma de la versión nueva no es válida; no se instalará."
msgstr "The signature of the new version is not valid; it will not be installed."

#: app/services/actualizador.py:555
msgid "Dirección de actualización no segura: solo se admite https."
msgstr "Insecure update address: only https is supported."

#: app/services/actualizador.py:571
msgid "No se pudo conectar con el servidor de actualizaciones. Compruebe la conexión a Internet."
msgstr "Could not connect to the update server. Check your Internet connection."

#: app/services/actualizador.py:586
#, python-format
msgid "El servidor de actualizaciones respondió con el error %s."
msgstr "The update server responded with error %s."

#: app/services/actualizador.py:588
msgid "El servidor de actualizaciones no respondió a tiempo."
msgstr "The update server did not respond in time."

#: app/services/actualizador.py:590
msgid "La información de versión del servidor es demasiado grande; se ignora."
msgstr "The version information from the server is too large; it will be ignored."

#: app/services/actualizador.py:594 app/services/actualizador.py:596
msgid "La información de versión del servidor está dañada."
msgstr "The version information from the server is damaged."

#: app/services/actualizador.py:608
msgid "La versión publicada es de otra aplicación; se ignora."
msgstr "The published version belongs to another application; it will be ignored."

#: app/services/actualizador.py:612
msgid "El servidor publica una versión con formato no válido."
msgstr "The server is publishing a version with an invalid format."

#: app/services/actualizador.py:614
msgid "El nombre del paquete publicado no es válido."
msgstr "The name of the published package is not valid."

#: app/services/actualizador.py:616
msgid "El paquete publicado no trae una huella SHA-256 válida."
msgstr "The published package does not include a valid SHA-256 hash."

#: app/services/actualizador.py:618
msgid "El tamaño del paquete publicado no es válido."
msgstr "The size of the published package is not valid."

#: app/services/actualizador.py:657
msgid "No hay ningún origen de actualizaciones configurado."
msgstr "No update source is configured."

#: app/services/actualizador.py:668
#, python-format
msgid "El servidor ofrece la versión %(nueva)s, anterior a la %(confirmada)s que ya se instaló en este equipo. Por seguridad se rechaza."
msgstr "The server is offering version %(nueva)s, which is older than version %(confirmada)s already installed on this computer. It has been rejected for security."

#: app/services/actualizador.py:740
#, python-format
msgid "El servidor respondió con el error %s al descargar la actualización."
msgstr "The server responded with error %s while downloading the update."

#: app/services/actualizador.py:756
msgid "Descarga cancelada. Podrá continuarla más tarde."
msgstr "Download canceled. You can resume it later."

#: app/services/actualizador.py:762 app/services/actualizador.py:776
msgid "La descarga se interrumpió. Vuelva a intentarlo: continuará donde se quedó."
msgstr "The download was interrupted. Try again: it will resume where it left off."

#: app/services/actualizador.py:771
msgid "El paquete descargado es mayor de lo anunciado; se descarta por seguridad."
msgstr "The downloaded package is larger than announced; it has been discarded for security."

#: app/services/actualizador.py:786
msgid "El paquete descargado no tiene el tamaño anunciado; no se instalará."
msgstr "The downloaded package does not have the announced size; it will not be installed."

#: app/services/actualizador.py:791
msgid "El paquete descargado no supera la verificación de integridad; no se instalará."
msgstr "The downloaded package failed the integrity check; it will not be installed."

#: app/services/actualizador.py:803
msgid "El paquete contiene un nombre de archivo no válido."
msgstr "The package contains an invalid file name."

#: app/services/actualizador.py:806
#, python-format
msgid "El paquete contiene una ruta absoluta (%s); se rechaza."
msgstr "The package contains an absolute path (%s); it has been rejected."

#: app/services/actualizador.py:810 app/services/actualizador.py:875
#, python-format
msgid "El paquete intenta escribir fuera de su carpeta (%s); se rechaza."
msgstr "The package tries to write outside its folder (%s); it has been rejected."

#: app/services/actualizador.py:812
#, python-format
msgid "El paquete contiene un nombre no válido en Windows (%s)."
msgstr "The package contains a name that is not valid in Windows (%s)."

#: app/services/actualizador.py:814
#, python-format
msgid "El paquete contiene un nombre reservado de Windows (%s)."
msgstr "The package contains a name reserved by Windows (%s)."

#: app/services/actualizador.py:836
msgid "El paquete contiene demasiados archivos; se rechaza."
msgstr "The package contains too many files; it has been rejected."

#: app/services/actualizador.py:843
#, python-format
msgid "El paquete contiene enlaces simbólicos (%s); se rechaza."
msgstr "The package contains symbolic links (%s); it has been rejected."

#: app/services/actualizador.py:845
msgid "El paquete contiene archivos cifrados; se rechaza."
msgstr "The package contains encrypted files; it has been rejected."

#: app/services/actualizador.py:850
#, python-format
msgid "El paquete repite el archivo %s; se rechaza."
msgstr "The package contains the file %s more than once; it has been rejected."

#: app/services/actualizador.py:855 app/services/actualizador.py:882
msgid "El paquete ocupa demasiado al descomprimirse; se rechaza."
msgstr "The package takes up too much space when extracted; it has been rejected."

#: app/services/actualizador.py:887
msgid "El paquete descargado está dañado."
msgstr "The downloaded package is damaged."

#: app/services/actualizador.py:893
#, python-format
msgid "El paquete no parece una versión de %s; no se instalará."
msgstr "The package does not look like a version of %s; it will not be installed."

#: app/services/actualizador.py:1199
msgid "La aplicación está en la raíz de una unidad; no se actualiza automáticamente."
msgstr "The application is in the root of a drive; it will not be updated automatically."

#: app/services/actualizador.py:1202
#, python-format
msgid "No se encuentra %s en la carpeta de la aplicación; no se puede actualizar."
msgstr "%s was not found in the application folder; the application cannot be updated."

#: app/services/actualizador.py:1206
#, python-brace-format
msgid "Nombre de subcarpeta de data no válido: {nombre!r}"
msgstr "Invalid data subfolder name: {nombre!r}"

#: app/services/actualizador.py:1288
msgid "Esta copia se ejecuta desde el código fuente: no se sustituye automáticamente."
msgstr "This copy runs from source code: it will not be replaced automatically."

#: app/services/actualizador.py:1293
msgid "No hay espacio libre suficiente en el disco para actualizar."
msgstr "There is not enough free disk space to update."

#: app/services/actualizador.py:1392
#, python-format
msgid "La versión %(nueva)s no arrancó correctamente y se ha vuelto a la versión %(actual)s. Sus datos no se han tocado. Los detalles están en data/logs/actualizacion.log."
msgstr "Version %(nueva)s did not start correctly, so the application has been rolled back to version %(actual)s. Your data has not been changed. Details are in data/logs/actualizacion.log."

#: app/services/actualizador.py:1399
#, python-format
msgid "La actualización a la versión %s no se aplicó porque la aplicación no llegó a cerrarse. Puede volver a intentarlo desde el menú Ayuda."
msgstr "The update to version %s was not applied because the application did not close. You can try again from the Help menu."

#: app/services/actualizador.py:1405
#, python-format
msgid "La actualización a la versión %s no se aplicó y la instalación no se ha tocado. Los detalles están en data/logs/actualizacion.log."
msgstr "The update to version %s was not applied and the installation has not been changed. Details are in data/logs/actualizacion.log."

#: app/services/actualizador.py:1410
#, python-format
msgid "La actualización a la versión %s tuvo un problema. Consulte data/logs/actualizacion.log."
msgstr "The update to version %s ran into a problem. See data/logs/actualizacion.log."

#: app/services/adjuntos.py:64
msgid "El archivo ocupa más de 10 MB; GitHub no admite adjuntar tanto texto."
msgstr "The file is larger than 10 MB; GitHub does not allow attaching that much text."

#: app/services/adjuntos.py:68
msgid "El archivo está vacío."
msgstr "The file is empty."

#: app/services/adjuntos.py:71
msgid "No es un archivo de texto. GitHub solo deja subir imágenes y otros archivos binarios desde su web: envíe el texto y, después, ábralo en el navegador con Control+B para arrastrar el archivo."
msgstr "This is not a text file. GitHub only allows uploading images and other binary files from its website: send the text and then open it in the browser with Control+B to drag the file there."

#: app/services/adjuntos.py:124
#, python-brace-format
msgid "Archivo adjunto: [{n}]({u})"
msgstr "Attached file: [{n}]({u})"

#: app/services/adjuntos.py:131
msgid "GitHub no devolvió la dirección del gist."
msgstr "GitHub did not return the gist URL."

#: app/services/busqueda.py:51 app/services/busqueda.py:74 app/services/busqueda.py:364 app/services/github/api_extra.py:551 app/ui/busqueda.py:274 app/ui/detalle/organizacion.py:98 app/ui/detalle/usuario.py:103 app/ui/detalle/usuario.py:210
